# ------------------------------------------------------------------ #
#  PeerConnect Backend Environment Configuration Example             #
# ------------------------------------------------------------------ #

# Flask Application Mode ('production' or 'development')
FLASK_ENV=production
FLASK_DEBUG=0

# Secret Key for Flask Session Cryptography (set to 32+ random characters)
SECRET_KEY=replace-with-a-secure-random-secret-key-32-chars

# Secret Key for Flask-JWT-Extended token signing
JWT_SECRET_KEY=replace-with-a-secure-jwt-signing-secret-key

# MongoDB Connection URI (Local standalone, replica set, or MongoDB Atlas)
# Format: mongodb://[username:password@]host[:port][/database][?options]
MONGO_URI=mongodb://127.0.0.1:27017/peerconnect

# Optional MongoDB Database Name override
MONGO_DB_NAME=peerconnect

# Allowed Frontend Origins for CORS (comma-separated list for multi-origin support)
FRONTEND_ORIGIN=https://peerconnect.example.com,http://localhost:5173,http://127.0.0.1:5173

# WSGI Server Listening Port (Standard: 5000)
PORT=5000
